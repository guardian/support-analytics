{
	"name": "super-mode-calculator",
	"version": "1.0.0",
	"license": "MIT",
	"private": true,
	"isAwsLambda": true,
	"cloudformation": "../cfn.yaml",
	"projectName": "Support::super-mode-calculator",
	"buildDir": "./target",
	"riffraffFile": "./riff-raff.yaml",
	"description": "Super mode calculator step functions",
	"scripts": {
		"lint": "eslint '*/**/*.ts'",
		"check-formatting": "prettier --check \"**/*.ts\"",
		"fix-formatting": "prettier --write \"**/*.ts\"",
		"build": "esbuild src/lambda.ts --bundle --platform=node --outfile=target/lambdas/lambda.js --external:@aws-sdk/*",
		"local": "STAGE=CODE AthenaOutputBucket=gu-support-analytics SchemaName=acquisition AWS_PROFILE=membership ts-node src/local/run.ts"
	},
	"devDependencies": {
		"@guardian/eslint-config": "16.0.0",
		"@guardian/prettier": "10.0.0",
		"@types/node": "22.10.6",
		"eslint": "9.39.5",
		"prettier": "3.7.4",
		"ts-node": "10.9.1",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"@aws-sdk/client-dynamodb": "3.1045.0",
		"@aws-sdk/client-ssm": "3.1045.0",
		"@aws-sdk/lib-dynamodb": "3.1045.0",
		"@google-cloud/bigquery": "8.1.1",
		"date-fns": "4.1.0",
		"esbuild": "0.28.1",
		"google-auth-library": "10.9.1",
		"zod": "4.3.6"
	},
	"prettier": "@guardian/prettier",
	"packageManager": "pnpm@10.33.0",
	"pnpm": {
		"overrides": {
			"flatted": "3.4.2",
			"picomatch": "2.3.2",
			"picomatch@4": "4.0.4",
			"@tootallnate/once": "3.0.1",
			"eslint-plugin-jsx-a11y>minimatch": "10.2.5",
			"eslint-plugin-react>minimatch": "10.2.5",
			"eslint>minimatch": "10.2.5",
			"@eslint/config-array>minimatch": "10.2.5",
			"@eslint/eslintrc>minimatch": "10.2.5",
			"minimatch>brace-expansion": "5.0.8"
		}
	}
}
